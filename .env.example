# ─── AdMob — used at build time in app.config.js ─────────────────────────────
# Get these from admob.google.com → Your app → App settings
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# ─── AdMob — used at runtime in services/ads.jsx ─────────────────────────────
# Get these from admob.google.com → Your app → Ad units
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# ─── RevenueCat — used at runtime in services/purchases.js ───────────────────
# Get these from app.revenuecat.com → Project → API keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_revenuecat_android_key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_ios_key
